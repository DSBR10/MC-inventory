# MC Inventory — ejemplo de configuración.
# NUNCA pongas valores reales aquí. Este archivo SÍ se commitea.
#
# Modelo de secretos:
# - CREDENTIALS_MASTER_KEY: clave maestra AES-256-GCM (base64, 32 bytes).
#   Genera con: node scripts/secrets.mjs generate-key
#   Vive SOLO en .env.master.key (local) o en tu secret manager (prod).
# - AK/SK y secrets operativos: guárdalos CIFRADOS como ENC:v1:... :
#     node scripts/secrets.mjs encrypt "<valor>"
#   La app los descifra SOLO en memoria. En disco nunca hay plaintext.
# - LOCAL_ADMIN_PASSWORD: NO usar en producción. Usa el HASH irreversible:
#     node scripts/secrets.mjs hash-password "<password>"
#   y configura LOCAL_ADMIN_PASSWORD_HASH=scrypt$... (no se puede desencriptar).
# - POSTGRES_PASSWORD: password de bootstrap del contenedor postgres.
#   Se inyecta en runtime (secret manager / .env gitignored), no se cifra
#   dentro del mismo .env porque postgres lo necesita en texto plano.

# Master key (requiere .env.master.key local o variable de entorno; no copiar aquí)
CREDENTIALS_MASTER_KEY=

# Application
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Cifrado: ENC:v1:...
NEXTAUTH_SECRET=ENC:v1:REEMPLAZAR_POR_VALOR_CIFRADO
AUDIT_HASH_SECRET=ENC:v1:REEMPLAZAR_POR_VALOR_CIFRADO

# PostgreSQL. Use the hostname postgres in Docker Compose.
DATABASE_URL=postgresql://mc_inventory:replace-with-postgres-password@postgres:5432/mc_inventory
DATABASE_SSL=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000
POSTGRES_DB=mc_inventory
POSTGRES_USER=mc_inventory
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Command execution policy
COMMAND_MAX_TARGETS=50
COMMAND_MAX_LENGTH=4000

# Authentication allowlists and role groups
ALLOWED_USERS=user1@example.com,user2@example.com
ADMIN_EMAILS=admin@example.com
ROLE_ADMIN_GROUPS=
ROLE_PLATAFORMAS_GROUPS=
ROLE_OPERACIONES_GROUPS=
ROLE_AUDIT_GROUPS=
LOCAL_ADMIN_USER=replace-with-local-admin-user
# Preferido (hash irreversible scrypt). Elimina LOCAL_ADMIN_PASSWORD al migrar.
LOCAL_ADMIN_PASSWORD_HASH=scrypt$16384$8$1$REEMPLAZAR_POR_HASH
# Solo migración local. NO usar en producción.
# LOCAL_ADMIN_PASSWORD=

# Azure AD (client secret va cifrado)
AZURE_AD_CLIENT_ID=replace-with-client-id
AZURE_AD_CLIENT_SECRET=ENC:v1:REEMPLAZAR_POR_VALOR_CIFRADO
AZURE_AD_TENANT_ID=replace-with-tenant-id

# AWS account 1 (repeat the block with another index for more accounts)
AWS_REGION=us-east-1
AWS_ACCOUNT_1_NAME=replace-with-account-name
AWS_ACCOUNT_1_ID=replace-with-account-id
AWS_ACCOUNT_1_ACCESS_KEY=ENC:v1:REEMPLAZAR_POR_VALOR_CIFRADO
AWS_ACCOUNT_1_SECRET_KEY=ENC:v1:REEMPLAZAR_POR_VALOR_CIFRADO
AWS_ACCOUNT_1_REGION=us-east-1

# Huawei account 1 (repeat the block with another index for more accounts)
HUAWEI_LTS_ENABLED=true
HUAWEI_ACCOUNT_1_NAME=replace-with-account-name
HUAWEI_ACCOUNT_1_PROJECT_ID=replace-with-project-id
HUAWEI_ACCOUNT_1_AK=ENC:v1:REEMPLAZAR_POR_VALOR_CIFRADO
HUAWEI_ACCOUNT_1_SK=ENC:v1:REEMPLAZAR_POR_VALOR_CIFRADO
HUAWEI_ACCOUNT_1_REGION=la-north-2

ENABLE_RDS_TAGS=false
